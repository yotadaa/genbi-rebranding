<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep editable CSS at ../assets/css authoritative. This lets the front
  # controller serve it instead of an old mirrored file under public/assets.
  RewriteCond %{REQUEST_URI} ^/assets/css/(tailwind|styles)\.css$
  RewriteRule ^ index.php [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  # PHP views load editable source CSS/JS directly. Do not keep a stale asset
  # after a File Manager upload just because its URL did not change.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
